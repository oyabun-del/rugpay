# Steam Top-up SaaS Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# FRONTEND / DOMAIN
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://your-domain.ru
NEXT_PUBLIC_API_URL=https://your-domain.ru/api
FRONTEND_URL=https://your-domain.ru
CORS_ORIGINS=["https://your-domain.ru"]

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=steam_topup
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/steam_topup

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_here
GUEST_SESSION_TTL_MINUTES=60
GUEST_CLEANUP_INTERVAL_MINUTES=30

# =============================================================================
# STEAM API
# =============================================================================
# Your Steam Web API key (from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Your Steam top-up provider API
STEAM_TOPUP_API_URL=
STEAM_TOPUP_API_KEY=

# Wata Digital Goods Steam top-up API (PRIMARY)
# Docs: https://wata.pro/api/digital-goods#rec1483091141
WATA_STEAM_TOPUP_ENABLED=true
WATA_DG_API_BASE_URL=https://dg-api.wata.pro/api
# Optional: if empty, backend falls back to WATA_ACCESS_TOKEN
WATA_DG_ACCESS_TOKEN=

# Legacy PlayWallet Steam top-up API (DISABLED, kept for rollback/reference)
PLAYWALLET_API_URL=https://dev-merchant.playwallet.bot/api/merchant
PLAYWALLET_API_KEY=
PLAYWALLET_SERVICE_ID=
PLAYWALLET_RUB_PER_USD=86.22

# =============================================================================
# PAYMENT PROVIDER (Wata - https://wata.pro/api)
# =============================================================================
# Enable/disable provider in app
WATA_ENABLED=true
# Wata API base URL (sandbox: https://api-sandbox.wata.pro/api/h2h, prod: https://api.wata.pro/api/h2h)
WATA_API_BASE_URL=https://api-sandbox.wata.pro/api/h2h
# JWT Access token from Wata merchant cabinet (Terminals -> create token)
WATA_ACCESS_TOKEN=
# Terminal public ID (optional, from terminal details in Wata cabinet)
WATA_TERMINAL_PUBLIC_ID=
# Use sandbox environment
WATA_USE_SANDBOX=true
# Frontend base URL for success/fail redirect after payment
FRONTEND_URL=https://rugpay.ru

# =============================================================================
# PAYMENT PROVIDER (YooKassa - https://yookassa.ru/developers/api#payment)
# =============================================================================
# Enable/disable provider in app
YOOKASSA_ENABLED=false
# API base URL
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
# Credentials from YooKassa cabinet
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Usually true for immediate capture
YOOKASSA_CAPTURE_PAYMENT=true

# Legacy: webhook secret (Wata uses X-Signature RSA, not this)
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER_API_KEY=

# =============================================================================
# FAZERCARDS API (PUBG MOBILE UC GIFT CARDS)
# Flow: user pays via Wata H2H → after payment confirmed → backend purchases
# gift card via FazerCards API → delivers to PUBG UID.
# =============================================================================
FAZERCARDS_ENABLED=false
FAZERCARDS_API_BASE_URL=https://api.fazercards.com/api/v1
FAZERCARDS_API_KEY=
# FX rate for converting real_price (provider currency) to RUB
FAZERCARDS_RUB_RATE=90
# Markup percent added on top of converted RUB price
FAZERCARDS_MARKUP_PERCENT=20
# Map each UC package to product_id from your FazerCards catalog
FAZERCARDS_PUBG_PRODUCT_ID_60=
FAZERCARDS_PUBG_PRODUCT_ID_325=
FAZERCARDS_PUBG_PRODUCT_ID_660=
FAZERCARDS_PUBG_PRODUCT_ID_1800=
FAZERCARDS_PUBG_PRODUCT_ID_3850=
FAZERCARDS_PUBG_PRODUCT_ID_8100=

# =============================================================================
# EMAIL (order notifications, registration, password reset)
# =============================================================================
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
JWT_PASSWORD_RESET_EXPIRE_MINUTES=30

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Set to true for development
DEBUG=false

# Commission settings (tiered)
COMMISSION_THRESHOLD_AMOUNT=1000
COMMISSION_PERCENT_UP_TO_THRESHOLD=16
COMMISSION_PERCENT_ABOVE_THRESHOLD=15
STEAM_DISCOUNT_PERCENT=5
PUBG_DISCOUNT_PERCENT=3

# Referral reward (percentage of commission)
REFERRAL_REWARD_PERCENT=10.0

# Order limits (in RUB)
MIN_TOPUP_AMOUNT=100.0
MAX_TOPUP_AMOUNT=50000.0

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
MAX_ORDERS_PER_MINUTE=5
MAX_FAILED_PAYMENTS_PER_HOUR=10

# =============================================================================
# FRONTEND
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
